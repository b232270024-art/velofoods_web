{
  "name": "hotel-dining-backend",
  "version": "0.1.0",
  "description": "Буудлын in-room dining захиалгын системийн backend",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "concurrently -n backend,frontend -c green,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node --watch src/index.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "migrate": "node src/db/migrate.js",
    "seed": "node scripts/seed-local.mjs",
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "translate:i18n": "node scripts/translate-i18n.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.5",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
