PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/hotel_dining
JWT_SECRET=change_this_to_a_long_random_string

# Optional — production (non-localhost) DB TLS-ийн CA сертификатын файлын зам.
# Тохируулаагүй бол src/db/pool.js асаах үедээ rejectUnauthorized:true-гаар
# нэг удаа урьдчилан холбогдож үзнэ: олон нийтийн CA-аар баталгаажвал
# автоматаар аюулгүй горимд ажиллана; self-signed сертификаттай бол
# (жишээ нь зарим Railway Postgres) тодорхой анхааруулга логтойгоор
# rejectUnauthorized:false горимд буцна. Railway-ийн DB сертификатыг олж
# (Railway dashboard эсвэл `openssl s_client -starttls postgres ...`-аар)
# энд заавал сорвол бүрэн баталгаажуулалттай (MITM-ээс хамгаалагдсан) болно.
# PGSSLROOTCERT=/path/to/ca-certificate.crt

# Admin dashboard (/dashboard) login.
# Generate ADMIN_PASSWORD_HASH with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$agHAxLoaf3h1NMqVmrspr.qPQAFNGJ.uFmM5H/ovl9tS0RU4F46DO

# Optional — enables Google Geocoding for reverse-geocoding "current location"
# addresses (more accurate than the free Nominatim fallback used without it).
# https://console.cloud.google.com/google/maps-apis/credentials — enable the
# "Geocoding API" for the key.
GOOGLE_GEOCODING_API_KEY=

# Hipay (hipay.mn) төлбөрийн систем.
# Sandbox: https://developers.hipay.mn/en/ — Хандах хаяг: https://test.hipay.mn
# entityId/client_secret-ийг Hipay-аас мерчант болохдоо авна.
HIPAY_API_BASE_URL=https://test.hipay.mn
HIPAY_ENTITY_ID=
HIPAY_CLIENT_SECRET=
# Hipay-д ямар валютаар дүн илгээхийг Hipay-аас лавлаж баталгаажуулсны дараа
# тохируулах. Тохируулаагүй бол payments.js буруу дүнгээр төлбөр авахаас
# сэргийлж алдаа шидэж зогсоно (fail fast).
# 'MNT' бол USD->MNT ханшийг ГАРААР тохируулах шаардлагагүй — Монголбанкнаас
# (mongolbank.mn) тухайн өдрийн албан ёсны ханшийг автоматаар татаж авна
# (src/services/exchangeRate.js). 'USD' бол ханш хэрэггүй.
HIPAY_CURRENCY=MNT
# Hipay-аас redirect/webhook ирэх backend endpoint-уудын БҮРЭН, PUBLIC HTTPS
# URL (Hipay сервер рүү дуудна тул localhost ажиллахгүй — ngrok/production
# домэйн хэрэгтэй).
HIPAY_REDIRECT_URI=https://yourdomain.com/api/payments/hipay/redirect
HIPAY_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook/hipay
# Төлбөрийн дараа хэрэглэгчийг буцаах frontend-ийн хаяг.
FRONTEND_URL=https://yourdomain.com
